{
  "name": "pi-for-office",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo — Pi-powered AI agent for Microsoft Office (Excel, Word, PowerPoint, Power BI)",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "bridge:dev": "pi --no-extensions -e ./packages/bridge-extension/src/index.ts --office-bridge-port 38618",
    "release": "node scripts/release.mjs",
    "release:status": "node scripts/release.mjs status",
    "release:check": "node scripts/release.mjs check",
    "release:publish": "node scripts/release.mjs publish"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  }
}
