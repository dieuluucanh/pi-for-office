{
  "name": "@dieulc/pi-office-bridge",
  "version": "0.6.0",
  "description": "Native Pi extension — WebSocket bridge + Office tool proxy so Pi can drive Excel, Word, and PowerPoint through the pi-for-office add-in.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dieuluucanh/pi-for-office"
  },
  "keywords": [
    "pi",
    "pi-package",
    "office",
    "excel",
    "word",
    "powerpoint",
    "bridge",
    "extension"
  ],
  "dependencies": {
    "@dieulc/pi-office-protocol": "^0.5.1",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.5.13",
    "typebox": "^1.3.10",
    "typescript": "^5.9.0"
  },
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test:active": "node --test tests/active-tools.test.mjs",
    "test:commands": "node --test tests/office-command.test.mjs",
    "test:lifecycle": "npm run build && node --test tests/bridge-lifecycle.test.mjs tests/bridge-server-lifecycle.test.mjs",
    "test:extension": "npm run build && node --test tests/extension-harness.test.mjs",
    "test:replies": "npm run build && node --test tests/pane-replies.test.mjs",
    "test:mentions": "npm run build && node --test tests/document-mentions.test.mjs",
    "test:smoke": "npm run build && node tests/smoke.mjs",
    "test:interop": "npm run build && node --import ./tests/register-ts-loader.mjs tests/pane-interop.mjs",
    "test:multi": "npm run build && node tests/multi-document.test.mjs",
    "test:package": "node ../../scripts/check-package-contents.mjs .",
    "test": "npm run test:active && npm run test:commands && npm run test:lifecycle && npm run test:extension && npm run test:replies && npm run test:mentions && npm run test:smoke && npm run test:interop && npm run test:multi && npm run test:package"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
